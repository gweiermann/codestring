{
  "name": "@codestring/eslint",
  "version": "0.1.0",
  "description": "Write ESLint rules as patterns: find this, say that, fix it like this.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codestring/core": "workspace:*",
    "@codestring/javascript": "workspace:*"
  },
  "peerDependencies": {
    "eslint": ">=8"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  },
  "main": "./dist/cjs/index.js"
}
