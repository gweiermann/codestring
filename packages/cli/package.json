{
  "name": "@codestring/cli",
  "version": "0.1.0",
  "description": "Structural grep and rewrite on the command line, for any registered codestring adapter.",
  "type": "module",
  "bin": {
    "codestring": "./dist/bin.js",
    "cs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@codestring/core": "workspace:*",
    "@codestring/html": "workspace:*",
    "@codestring/javascript": "workspace:*",
    "@codestring/twig": "workspace:*",
    "@codestring/css": "workspace:*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "clean": "rm -rf dist"
  },
  "main": "./dist/cjs/index.js"
}
