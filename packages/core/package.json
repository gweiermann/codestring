{
  "name": "@codestring/core",
  "version": "0.1.0",
  "description": "Language-agnostic structural pattern matching and source-preserving transformation. No parser dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "clean": "rm -rf dist"
  },
  "main": "./dist/cjs/index.js"
}
