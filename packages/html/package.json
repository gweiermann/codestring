{
  "name": "@codestring/html",
  "version": "0.1.0",
  "description": "HTML language adapter for codestring, backed by parse5.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@codestring/adapter-utils": "workspace:*",
    "parse5": "^7.2.1"
  },
  "peerDependencies": {
    "@codestring/core": "workspace:*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@codestring/core": "workspace:*"
  },
  "main": "./dist/cjs/index.js"
}
